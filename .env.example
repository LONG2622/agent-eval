# ============== LLM API Configuration ==============
# Default model used by Agent + Web UI on startup.
# Stable options: tju-llm (TJU native), deepseek-ai/deepseek-v4-pro-0813 (NVIDIA marketplace)
LLM_DEFAULT_MODEL=tju-llm

# --- Tianjin University (native Chinese, supports function calling) ---
TJU_API_KEY=your-tju-api-key
TJU_BASE_URL=https://ai.tju.edu.cn/api/v3/
TJU_MODEL_NAME=tju-llm

# --- NVIDIA A: DeepSeek V4 Pro 0813 (reasoning / code / Chinese, supports thinking) ---
# Note: marketplace model hosted on integrate.api.nvidia.com, re-check NVIDIA API catalog for latest names.
NVIDIA_LLAMA_API_KEY=nvapi-your-deepseek-key
NVIDIA_LLAMA_BASE_URL=https://integrate.api.nvidia.com/v1/
NVIDIA_LLAMA_MODEL_NAME=deepseek-ai/deepseek-v4-pro-0813

# --- NVIDIA B: Moonshot Kimi K3 (multimodal / Vision / long context / Chinese reasoning) ---
# Note: Function calling on Kimi is unconfirmed on NVIDIA marketplace,
# the profile disables FC so the Agent auto-degrades to the scratchpad mode.
NVIDIA_QWEN_API_KEY=nvapi-your-kimi-key
NVIDIA_QWEN_BASE_URL=https://integrate.api.nvidia.com/v1/
NVIDIA_QWEN_MODEL_NAME=moonshotai/kimi-k3

# ============== Runtime Configuration ==============
AGENT_MAX_STEPS=10
STEP_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=20000

# ============== Output Paths ==============
OUTPUT_DIR=./outputs
TRACE_DIR=./outputs/traces
RUN_DIR=./outputs/runs
EVAL_DIR=./outputs/evaluations

# ============== LLM Pricing (USD per 1K tokens) ==============
# tju-llm 是校内平台配额制，按 0 处理；如需按实际结算请修改
PRICING_TJU_LLM_PROMPT=0.0
PRICING_TJU_LLM_COMPLETION=0.0
# DeepSeek V4 Pro on NVIDIA marketplace – fill in if you track cost
PRICING_DEEPSEEK_V4_PROMPT=0.0
PRICING_DEEPSEEK_V4_COMPLETION=0.0
# Moonshot Kimi K3 on NVIDIA marketplace
PRICING_KIMI_K3_PROMPT=0.0
PRICING_KIMI_K3_COMPLETION=0.0
# 备用模型定价（如接入 OpenAI GPT 系列；通过扩展 TJU/NVIDIA 段外的环境变量使用）
PRICING_GPT_4O_MINI_PROMPT=0.00015
PRICING_GPT_4O_MINI_COMPLETION=0.0006
PRICING_GPT_4O_PROMPT=0.005
PRICING_GPT_4O_COMPLETION=0.015
